# ===== 必填 =====

# LLM 统一入口（推荐自建 CLIProxyAPI：https://github.com/luispater/CLIProxyAPI）。
# 语义裁决/标题/封面走 GPT 系列，转写精修/声学听写走 Gemini 系列，都经这一个入口。
CPA_BASE_URL=https://your-cpa-host/v1
CPA_API_KEY=your-key

# Gemini（转写精修/声学听写）。免费 key 轮换位与付费兜底位可留空。
GEMINI_API_KEY=
GEMINI_KEY_BACKUP=

# ===== 部署布局 =====

# 管线状态/工作根（state、缓存、交付都在它下面；不是录播目录）。
AUTOSLICE_BASE=/opt/bilive/autoslice

# 录播根目录（BililiveRecorder 输出；按 <room_id>/ 分房间目录）。
# BILIVE_VIDEOS_ROOT=/opt/bilive/Videos

# ===== 频道 profile =====

# 选择频道 profile（profiles/<id>/profile.json；默认是 lidousha 示例 profile）。
# 管线在进程 import 时读取——启动 runner 前设置，不要在运行中改。
# AUTOSLICE_PROFILE=lidousha

# 上传兜底的频道身份数据。正常发布流程中 tags/简介由 authorized_upload.py 的
# manifest 冻结；这两个只是 do_upload.sh 在 manifest 缺项时的兜底。换频道必须
# 换成你自己的，绝不要用别人频道的简介上传。
# AUTOSLICE_UPLOAD_DESC="你的频道简介（写进稿件简介）"
# AUTOSLICE_FALLBACK_TAGS=虚拟主播,直播切片

# 封面表情包通道的媒体目录（媒体不入库）。
# AUTOSLICE_EMOTE_DIR=/path/to/emote/media
