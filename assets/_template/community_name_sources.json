{
  "schema_version": "vtuber-slice.community-name-sources.v2",
  "search_endpoint": "https://api.bilibili.com/x/web-interface/wbi/search/type",
  "reply_endpoint": "https://api.bilibili.com/x/v2/reply/wbi/main",
  "wbi_nav_endpoint": "https://api.bilibili.com/x/web-interface/nav",
  "source_hosts": ["bilibili.com"],
  "max_registry_members": 128,
  "historical_member_limit": 16,
  "candidate_query_limit": 8,
  "max_results": 50,
  "max_search_pages": 3,
  "max_requests": 177,
  "comment_discovery_video_limit": 24,
  "comments_per_video": 20,
  "prompt_batch_member_limit": 16,
  "prompt_rows_per_member": 50,
  "request_interval_seconds": 10.0,
  "max_runtime_seconds": 2400,
  "lookback_days": 730,
  "max_evidence_per_mapping": 64,
  "query_suffixes": ["", " 切片"],
  "query_orders": ["pubdate", "totalrank", "click"],
  "acceptance": {
    "minimum_score": 8,
    "minimum_videos": 4,
    "minimum_uploaders": 3,
    "minimum_days": 2,
    "minimum_strong_links": 2,
    "meme_minimum_score": 5,
    "meme_minimum_videos": 2,
    "meme_minimum_uploaders": 2,
    "meme_minimum_strong_links": 2,
    "official_minimum_score": 5,
    "official_minimum_videos": 2,
    "official_minimum_uploaders": 2,
    "comment_minimum_commenters": 4,
    "comment_minimum_videos": 2,
    "comment_minimum_days": 2,
    "official_comment_minimum_commenters": 3,
    "official_comment_minimum_videos_or_days": 2,
    "meme_comment_minimum_commenters": 3,
    "meme_comment_minimum_videos": 2
  }
}
