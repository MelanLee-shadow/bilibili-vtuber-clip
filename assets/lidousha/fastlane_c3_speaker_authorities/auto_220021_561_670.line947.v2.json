  "cues": [
    {"cue": 1, "start": "00:00:26,750", "end": "00:00:31,550", "text": "星兰不会死啊，她怎么可能会被美美杀死", "speaker": "李豆沙"},
    {"cue": 2, "start": "00:00:33,970", "end": "00:00:37,370", "text": "没有了，只更新到这一集了", "speaker": "李豆沙"},
    {"cue": 3, "start": "00:00:37,450", "end": "00:00:39,890", "text": "我们下次一起看", "speaker": "李豆沙"},
    {"cue": 4, "start": "00:01:04,280", "end": "00:01:08,440", "text": "李豆包，帮我生成《与你相恋到生命尽头》第七集", "speaker": "李豆沙"},
    {"cue": 5, "start": "00:01:09,610", "end": "00:01:12,530", "text": "哎，大家会忍不住去看漫画吗？", "speaker": "李豆沙"},
    {"cue": 6, "start": "00:01:12,890", "end": "00:01:18,090", "text": "还是决定要忍到下一集，下周看动画呀？", "speaker": "李豆沙"},
    {"cue": 7, "start": "00:01:27,310", "end": "00:01:30,150", "text": "欧耶", "speaker": "李豆沙"},
    {"cue": 8, "start": "00:01:31,630", "end": "00:01:36,670", "text": "宝，没有下一集啊，要等下周了。能忍住。", "speaker": "李豆沙"},
    {"cue": 9, "start": "00:01:37,140", "end": "00:01:40,740", "text": "打算看完动画去补。", "speaker": "李豆沙"},
    {"cue": 10, "start": "00:01:42,720", "end": "00:01:45,040", "text": "对，因为漫画更新得很慢。", "speaker": "李豆沙"},
    {"cue": 11, "start": "00:01:45,900", "end": "00:01:48,940", "text": "漫画你要看的话，其实一下子就看完了。", "speaker": "李豆沙"}
  ],
