[Unit]
Description=Archive sealed OCI3 local recordings through CloudDrive2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
# --lane-root: keep a segment local until the clip lane has copied it (oci3_lane_spool_copy.sh, same room)
ExecStart=/usr/bin/python3 -B /opt/bilive/ops/recording_spool_mover.py --lane-root /home/user/manual-work/recordings-direct/22966160
Restart=on-failure
RestartSec=30
SyslogIdentifier=oci3-recording-spool

[Install]
WantedBy=multi-user.target
