# Refuse to run the host-side health audit on a plain system-disk directory.
# The same strict CloudFS/FUSE probe is shared with the recorder boot gate.
2-52/10 * * * * root /usr/bin/flock -n /opt/bilive/autoslice/watchdog.lock /bin/bash -lc 'set -eu; if [ -e /opt/bilive/autoslice/recording-health.env ] || [ -L /opt/bilive/autoslice/recording-health.env ]; then [ -f /opt/bilive/autoslice/recording-health.env ] && [ ! -L /opt/bilive/autoslice/recording-health.env ] || exit 1; env_owner_mode="$(stat -c '\''\%u:\%a'\'' /opt/bilive/autoslice/recording-health.env 2>/dev/null || stat -f '\''\%u:\%Lp'\'' /opt/bilive/autoslice/recording-health.env 2>/dev/null || true)"; [ "$env_owner_mode" = "0:600" ] || exit 1; set -a; . /opt/bilive/autoslice/recording-health.env; set +a; fi; /opt/bilive/autoslice/mount_watchdog.sh --probe-only && /usr/bin/python3 /opt/bilive/ops/record_health_audit.py --lookback-hours 96' >> /opt/bilive/autoslice/logs/record-health-cron.log 2>&1
