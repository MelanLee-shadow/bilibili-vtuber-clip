{
 "cid": "semantictalk_1529440_1694570",
 "clip_len_s": 165.356,
 "cues": [
  {
   "id": 1,
   "start_s": 0.24,
   "end_s": 1.6,
   "text": "四萌小李都看过"
  },
  {
   "id": 2,
   "start_s": 1.6,
   "end_s": 3.08,
   "text": "没见你说《旋风管家》"
  },
  {
   "id": 3,
   "start_s": 3.08,
   "end_s": 4.68,
   "text": "我还没看过《旋风管家》"
  },
  {
   "id": 4,
   "start_s": 4.8,
   "end_s": 6.36,
   "text": "《旋风管家》是那个"
  },
  {
   "id": 5,
   "start_s": 6.36,
   "end_s": 7.08,
   "text": "嗯"
  },
  {
   "id": 6,
   "start_s": 9.06,
   "end_s": 11.38,
   "text": "女主是粉色头发的那个吗"
  },
  {
   "id": 7,
   "start_s": 12.78,
   "end_s": 13.64,
   "text": "嗯，不是"
  },
  {
   "id": 8,
   "start_s": 13.64,
   "end_s": 14.9,
   "text": "那我没看过，没看过"
  },
  {
   "id": 9,
   "start_s": 14.9,
   "end_s": 15.9,
   "text": "《旋风管家》"
  },
  {
   "id": 10,
   "start_s": 17.81,
   "end_s": 18.97,
   "text": "你朋友推荐过"
  },
  {
   "id": 11,
   "start_s": 18.97,
   "end_s": 19.97,
   "text": "但是没有看"
  },
  {
   "id": 12,
   "start_s": 20.17,
   "end_s": 20.77,
   "text": "嗯"
  },
  {
   "id": 13,
   "start_s": 20.97,
   "end_s": 21.89,
   "text": "推荐一下"
  },
  {
   "id": 14,
   "start_s": 21.89,
   "end_s": 23.17,
   "text": "我觉得很好看"
  },
  {
   "id": 15,
   "start_s": 23.88,
   "end_s": 26.4,
   "text": "钉宫四萌是哪四萌啊"
  },
  {
   "id": 16,
   "start_s": 26.68,
   "end_s": 29.08,
   "text": "《旋风管家》《龙与虎》"
  },
  {
   "id": 17,
   "start_s": 29.76,
   "end_s": 30.92,
   "text": "还有什么"
  },
  {
   "id": 18,
   "start_s": 31.24,
   "end_s": 32.08,
   "text": "夏娜"
  },
  {
   "id": 19,
   "start_s": 33.28,
   "end_s": 35.2,
   "text": "但是我很喜欢亚里亚呀"
  },
  {
   "id": 20,
   "start_s": 35.2,
   "end_s": 36.64,
   "text": "我最喜欢的是亚里亚"
  },
  {
   "id": 21,
   "start_s": 37.74,
   "end_s": 39.56,
   "text": "我，我最喜欢的"
  },
  {
   "id": 22,
   "start_s": 39.56,
   "end_s": 42.34,
   "text": "可是我最喜欢的是亚里亚，零，哦对对"
  },
  {
   "id": 23,
   "start_s": 42.34,
   "end_s": 43.62,
   "text": "《零之使魔》"
  },
  {
   "id": 24,
   "start_s": 44.24,
   "end_s": 46.6,
   "text": "那我说的粉头发的是《零之使魔》"
  },
  {
   "id": 25,
   "start_s": 46.8,
   "end_s": 47.8,
   "text": "不管怎么样"
  },
  {
   "id": 26,
   "start_s": 47.8,
   "end_s": 49.28,
   "text": "我最喜欢的还是亚里亚"
  },
  {
   "id": 27,
   "start_s": 49.28,
   "end_s": 51.54,
   "text": "虽然她不算钉宫四萌里面的"
  },
  {
   "id": 28,
   "start_s": 51.54,
   "end_s": 52.2,
   "text": "但是"
  },
  {
   "id": 29,
   "start_s": 53.59,
   "end_s": 56.47,
   "text": "天蓝青就是《旋风管家》男主啊"
  },
  {
   "id": 30,
   "start_s": 56.47,
   "end_s": 58.96,
   "text": "这，原来如此"
  },
  {
   "id": 31,
   "start_s": 59.56,
   "end_s": 62.12,
   "text": "原来是这样，学到了"
  },
  {
   "id": 32,
   "start_s": 64.3,
   "end_s": 66.34,
   "text": "我没有，我没有看过《旋风管家》"
  },
  {
   "id": 33,
   "start_s": 66.34,
   "end_s": 67.88,
   "text": "我最喜欢的还是亚里亚"
  },
  {
   "id": 34,
   "start_s": 67.88,
   "end_s": 68.94,
   "text": "亚里亚不配上桌"
  },
  {
   "id": 35,
   "start_s": 68.94,
   "end_s": 69.78,
   "text": "什么意思呢"
  },
  {
   "id": 36,
   "start_s": 70.34,
   "end_s": 73.3,
   "text": "亚里亚才是我心中最萌，可，可是"
  },
  {
   "id": 37,
   "start_s": 73.83,
   "end_s": 79.05,
   "text": "有没有可能就是我当时追连载的时候"
  },
  {
   "id": 38,
   "start_s": 79.05,
   "end_s": 81.31,
   "text": "我那时候还，我那时候还在上初中"
  },
  {
   "id": 39,
   "start_s": 81.74,
   "end_s": 84.12,
   "text": "上初中我在追连载的时候"
  },
  {
   "id": 40,
   "start_s": 84.12,
   "end_s": 85.7,
   "text": "我只看了亚里亚"
  },
  {
   "id": 41,
   "start_s": 85.98,
   "end_s": 88.62,
   "text": "然后你们说的什么《旋风管家》什么的"
  },
  {
   "id": 42,
   "start_s": 88.62,
   "end_s": 90.8,
   "text": "那个时候都已经结束了"
  },
  {
   "id": 43,
   "start_s": 90.8,
   "end_s": 92.94,
   "text": "这已经不是我这个年纪的了哈"
  },
  {
   "id": 44,
   "start_s": 93.28,
   "end_s": 95.74,
   "text": "都是老登，老登看的了"
  },
  {
   "id": 45,
   "start_s": 95.74,
   "end_s": 96.08,
   "text": "嗯"
  },
  {
   "id": 46,
   "start_s": 96.08,
   "end_s": 97.7,
   "text": "什么什么《龙与虎》"
  },
  {
   "id": 47,
   "start_s": 97.7,
   "end_s": 99.2,
   "text": "什么《旋风管家》"
  },
  {
   "id": 48,
   "start_s": 99.32,
   "end_s": 102.1,
   "text": "我都，我那个真是不好意思"
  },
  {
   "id": 49,
   "start_s": 102.1,
   "end_s": 103.52,
   "text": "小李出生比较晚"
  },
  {
   "id": 50,
   "start_s": 103.52,
   "end_s": 106.28,
   "text": "错过了它们连载的时期了"
  },
  {
   "id": 51,
   "start_s": 108.74,
   "end_s": 110.06,
   "text": "谢谢刚刚"
  },
  {
   "id": 52,
   "start_s": 110.13,
   "end_s": 112.21,
   "text": "谢谢刚刚A送的比心"
  },
  {
   "id": 53,
   "start_s": 112.21,
   "end_s": 112.89,
   "text": "谢谢你啊"
  },
  {
   "id": 54,
   "start_s": 112.89,
   "end_s": 115.25,
   "text": "ありがと，谢谢听歌不限风格的灯牌"
  },
  {
   "id": 55,
   "start_s": 115.25,
   "end_s": 116.92,
   "text": "谢谢三理理的冰美式的灯牌"
  },
  {
   "id": 56,
   "start_s": 116.92,
   "end_s": 118.9,
   "text": "谢谢小鸟仙贝单推型的灯牌"
  },
  {
   "id": 57,
   "start_s": 118.9,
   "end_s": 119.88,
   "text": "谢谢你"
  },
  {
   "id": 58,
   "start_s": 121.99,
   "end_s": 124.55,
   "text": "可能亚里亚原作剧情不太讨喜"
  },
  {
   "id": 59,
   "start_s": 125.77,
   "end_s": 127.81,
   "text": "她人萌就可以了"
  },
  {
   "id": 60,
   "start_s": 128.09,
   "end_s": 129.37,
   "text": "我都是亚里亚"
  },
  {
   "id": 61,
   "start_s": 129.37,
   "end_s": 130.21,
   "text": "我是长大"
  },
  {
   "id": 62,
   "start_s": 130.33,
   "end_s": 132.17,
   "text": "长大了很久之后"
  },
  {
   "id": 63,
   "start_s": 132.17,
   "end_s": 133.89,
   "text": "我才知道它是个后宫番"
  },
  {
   "id": 64,
   "start_s": 135.41,
   "end_s": 138.37,
   "text": "就小时候我可能也没怎么看它的剧情"
  },
  {
   "id": 65,
   "start_s": 138.69,
   "end_s": 141.01,
   "text": "然后我也没有觉得"
  },
  {
   "id": 66,
   "start_s": 141.43,
   "end_s": 142.03,
   "text": "呃"
  },
  {
   "id": 67,
   "start_s": 142.27,
   "end_s": 143.99,
   "text": "它的剧情好看还不好看"
  },
  {
   "id": 68,
   "start_s": 143.99,
   "end_s": 145.71,
   "text": "我只觉得她很，很萌"
  },
  {
   "id": 69,
   "start_s": 145.87,
   "end_s": 148.53,
   "text": "我当时就纯觉得女主又萌又帅"
  },
  {
   "id": 70,
   "start_s": 148.53,
   "end_s": 150.11,
   "text": "就是非常"
  },
  {
   "id": 71,
   "start_s": 150.39,
   "end_s": 153.23,
   "text": "至少你长大也想成为这种人的感觉"
  },
  {
   "id": 72,
   "start_s": 154.9,
   "end_s": 155.62,
   "text": "就是"
  },
  {
   "id": 73,
   "start_s": 155.62,
   "end_s": 160.46,
   "text": "就是感觉长大之后也想成为这种什么双刀双枪双马尾"
  },
  {
   "id": 74,
   "start_s": 160.46,
   "end_s": 161.25,
   "text": "然后可以在"
  },
  {
   "id": 75,
   "start_s": 161.25,
   "end_s": 165.15,
   "text": "就是很普通地从天上跳下来的这种，这种人"
  }
 ],
